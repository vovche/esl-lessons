{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable ESL homework check",
  "type": "object",
  "required": ["schema_version", "id", "title", "grade", "purpose", "source_lesson", "source_title", "assessment_lesson", "placement", "assessment", "total_points", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "grade": {"enum": [6, 7, 9]},
    "purpose": {"const": "homework_check"},
    "source_lesson": {"type": "string", "pattern": "^[679]/[^/]+/index\\.html$"},
    "source_title": {"type": "string", "minLength": 1},
    "assessment_lesson": {"type": "string", "pattern": "^[679]/[^/]+/index\\.html$"},
    "placement": {
      "type": "object",
      "required": ["rule", "note"],
      "properties": {"rule": {"enum": ["next_lesson", "no_next_lesson"]}, "note": {"type": "string"}}
    },
    "assessment": {
      "type": "object",
      "required": ["deadline", "semester", "timezone"],
      "properties": {
        "deadline": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"},
        "semester": {"enum": [1, 2, "annual"]},
        "timezone": {"const": "Europe/Kyiv"}
      }
    },
    "total_points": {"const": 10},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "prompt", "points"],
        "properties": {
          "type": {"enum": ["choice", "word"]},
          "prompt": {"type": "string", "minLength": 1},
          "points": {"type": "integer", "minimum": 1, "maximum": 10},
          "options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "key": {"type": "integer", "minimum": 0},
          "answers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "choice"}}}, "then": {"required": ["options", "key"]}},
          {"if": {"properties": {"type": {"const": "word"}}}, "then": {"required": ["answers"]}}
        ]
      }
    },
    "platforms": {"type": "object", "description": "Optional platform-specific IDs, links and launch state; the test content is usable without this field."}
  }
}
